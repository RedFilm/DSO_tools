  <LuaScript>
-- DrakenHub launches SpeedBoost with WorkingDirectory = SpeedBoostEngine
local function trainerLog(msg)
  local base = os.getenv("LOCALAPPDATA") or "."
  local dir = base .. "\\DrakenHub\\SpeedBoostIpc"
  pcall(function()
    if createDirectory then createDirectory(dir) end
  end)
  local f = io.open(dir .. "\\bridge.log", "a")
  if f then
    f:write(os.date("%H:%M:%S") .. " [CETRAINER] " .. tostring(msg) .. "\n")
    f:close()
  end
end
trainerLog("LuaScript start")
local function loadBridge()
  local candidates = {
    "bridge.lua",
    ".\\bridge.lua"
  }
  pcall(function()
    if getCheatEngineDir then
      table.insert(candidates, 1, getCheatEngineDir() .. "bridge.lua")
    end
  end)
  for _, path in ipairs(candidates) do
    local f = io.open(path, "r")
    if f then
      f:close()
      trainerLog("dofile " .. path)
      local ok, err = pcall(dofile, path)
      if not ok then
        trainerLog("bridge error: " .. tostring(err))
        showMessage("DrakenHub SpeedBoost bridge error:\n" .. tostring(err))
      else
        trainerLog("dofile ok")
      end
      return
    end
  end
  trainerLog("bridge.lua not found")
  showMessage("DrakenHub SpeedBoost: bridge.lua not found next to SpeedBoost.exe")
end
loadBridge()
  </LuaScript>
</CheatTable>
